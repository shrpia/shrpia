//@version=6
indicator("AIB Angles ABCDE — Ultra Runtime v2.30 RC2", shorttitle="AIB ABCDE v2.30 RC2", overlay=true, scale=scale.none, behind_chart=false, format=format.price, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=5000, calc_bars_count=4000, dynamic_requests=true)
// v2.30 RC2: calc_bars_count values are explicitly kept as simple int for request.* compatibility.

// ═══════════════════════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════════════════════

grpCore = "═══ Core Settings ═══"
i_unitTF      = input.timeframe("D", "Unit Timeframe", group=grpCore, tooltip="Each bar on this timeframe is treated as one unit.")
i_unitsToScan = input.int(60, "Units to scan (calculation)", minval=4, maxval=200, group=grpCore)
i_touchTolPts = input.int(2, "Touch tolerance (points)", minval=0, group=grpCore)

grpUnitPreset = "═══ Unit Selection / 6H / 8H ═══"
i_unitSelectionMode = input.string("Auto Standard", "Unit Selection Mode", options=["Auto Standard", "Manual"], group=grpUnitPreset)
i_unitTFMode = input.string("Use Unit Timeframe", "Unit Timeframe Mode", options=["Use Unit Timeframe", "6 Hours", "8 Hours"], group=grpUnitPreset)
i_virtualHigherUnitBars = input.int(2, "Highest-TF virtual-unit bars", minval=2, maxval=6, group=grpUnitPreset, tooltip="When Pine has no strictly higher supported timeframe (for example 12M, 52W or 365D), Auto Standard groups this many chart bars into one virtual unit. Default 2.")

grpFilter88 = "═══ Filter 88 ═══"
i_enableFilter88 = input.bool(true, "Enable Filter 88", group=grpFilter88)
i_showFailedFilter88 = input.bool(false, "Show angles that fail Filter 88", group=grpFilter88)

grpDraw = "═══ Angle Drawing ═══"
i_showConfirmed   = input.bool(true, "Show confirmed angles", group=grpDraw)
i_showUnconfirmed = input.bool(true, "Show unconfirmed/candidate angles", group=grpDraw)
i_showUnitLegs    = input.bool(true, "Show unit vertical legs", group=grpDraw)
i_showClassText   = input.bool(true, "Show classification (ZA/ZB/ZC/ZD/ZE)", group=grpDraw)
i_showCorrText    = input.bool(false, "Show correction %", group=grpDraw)
i_showAngleText   = input.bool(false, "Show BUY/SELL text", group=grpDraw)
i_angleHistoryDraw = input.int(55, "Maximum visible historical angles", minval=5, maxval=120, group=grpDraw, tooltip="Visual limit only. Calculations keep their configured depth.")

grpStyle = "═══ Angle Style ═══"
i_classColorABC = input.color(color.rgb(190, 198, 204), "ZA / ZB / ZC text color", group=grpStyle)
i_classColorDE  = input.color(color.rgb(104, 151, 166), "ZD / ZE text color", group=grpStyle)
i_corrColor     = input.color(color.rgb(160, 123, 78), "Correction text color", group=grpStyle)
i_legWidth   = input.int(2, "Vertical line width", minval=1, maxval=4, group=grpStyle)
i_angleWidth = input.int(2, "Diagonal line width", minval=1, maxval=4, group=grpStyle)
i_useOriginalBrightAngleColors = input.bool(false, "Use original bright yellow / white angle colors", group=grpStyle, tooltip="OFF uses a muted gold and soft gray to reduce eye strain. Calculations are unchanged.")
i_softAngleGold  = input.color(color.rgb(178, 151, 73), "Muted angle gold", group=grpStyle)
i_softAngleLight = input.color(color.rgb(198, 204, 208), "Muted angle light", group=grpStyle)

grpPerf = "═══ Performance / Safety ═══"
i_performancePreset = input.string("Ultra Light", "Performance preset", options=["Ultra Light", "Balanced", "Research", "Custom"], group=grpPerf)
i_autoSafeMode = input.bool(true, "Automatic safe mode", group=grpPerf, tooltip="Reduces historical drawings first; never disables angle/test calculations.")
i_showPerformanceWarning = input.bool(true, "Show safety/performance status", group=grpPerf)
i_autoSizeMTFRequests = input.bool(true, "Auto-size MTF request history", group=grpPerf, tooltip="ON requests only the estimated source bars needed for the configured unit depth. OFF uses the full Custom requested source bars value for maximum historical coverage.")
i_dashboardRefreshBars = input.int(3, "Dashboard refresh every N bars", minval=1, maxval=20, group=grpPerf, tooltip="Visual refresh only. Ultra Light uses this interval to reduce table work; calculations remain bar-by-bar.")

grpFibo = "═══ Fibonacci Units Grid ═══"
i_showFiboGrid       = input.bool(true, "Show Fibonacci Units Grid", group=grpFibo)
i_showFiboRatioLines = input.bool(true, "Show ratio lines", group=grpFibo)
i_showFiboRatioLabels = input.bool(true, "Show ratio labels", group=grpFibo)
i_fiboUnitsBack       = input.int(6, "Visible closed units", minval=1, maxval=20, group=grpFibo, tooltip="Visual depth only. Ultra Light default is 6.")
i_fiboLabelUnits      = input.int(2, "Newest units with ratio labels", minval=0, maxval=6, group=grpFibo)
i_showUnitNumbers     = input.bool(true, "Show unit numbers", group=grpFibo)
i_showWeekStartMarker = input.bool(true, "Highlight week-start boundary", group=grpFibo)
i_showUnit0Separator     = input.bool(true, "Show U1/U0 real boundary", group=grpFibo)
i_showProjectedSeparator = input.bool(true, "Show projected next-unit boundary", group=grpFibo)
i_projSepColor        = input.color(color.new(color.gray, 55), "Projected boundary color", group=grpFibo)
i_fiboLabelSize       = input.string("Tiny", "Ratio label size", options=["Tiny", "Small"], group=grpFibo)

grpFiboColor = "═══ Fibonacci Grid — Colors / Styles ═══"
i_fibo_0100_color = input.color(#476E82, "0.0 / 100.0", group=grpFiboColor, inline="l0")
i_fibo_0100_style = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group=grpFiboColor, inline="l0")
i_fibo_0100_width = input.int(2, "Width", minval=1, maxval=4, group=grpFiboColor, inline="l0")
i_fibo_236_color  = input.color(#73677B, "23.6 / 76.4", group=grpFiboColor, inline="l1")
i_fibo_236_style  = input.string("Dashed", "Style", options=["Solid", "Dashed", "Dotted"], group=grpFiboColor, inline="l1")
i_fibo_236_width  = input.int(1, "Width", minval=1, maxval=4, group=grpFiboColor, inline="l1")
i_fibo_382_color  = input.color(#806C4B, "38.2 / 61.8 / 138.2 / -38.2", group=grpFiboColor, inline="l2")
i_fibo_382_style  = input.string("Dotted", "Style", options=["Solid", "Dashed", "Dotted"], group=grpFiboColor, inline="l2")
i_fibo_382_width  = input.int(1, "Width", minval=1, maxval=4, group=grpFiboColor, inline="l2")
i_fibo_50_color   = input.color(#496F69, "50.0", group=grpFiboColor, inline="l3")
i_fibo_50_style   = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group=grpFiboColor, inline="l3")
i_fibo_50_width   = input.int(1, "Width", minval=1, maxval=4, group=grpFiboColor, inline="l3")
i_fibo_118_color  = input.color(#4F7565, "11.8 / 88.0 / 111.8 / -11.8", group=grpFiboColor, inline="l4")
i_fibo_118_style  = input.string("Dotted", "Style", options=["Solid", "Dashed", "Dotted"], group=grpFiboColor, inline="l4")
i_fibo_118_width  = input.int(1, "Width", minval=1, maxval=4, group=grpFiboColor, inline="l4")
i_fibo_123_color  = input.color(#73677B, "123.6 / -23.6", group=grpFiboColor, inline="l5")
i_fibo_123_style  = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group=grpFiboColor, inline="l5")
i_fibo_123_width  = input.int(2, "Width", minval=1, maxval=4, group=grpFiboColor, inline="l5")
i_weekMarkerColor = input.color(#73677B, "Week-start marker", group=grpFiboColor)
i_sepColor        = input.color(color.new(color.gray, 82), "Normal separator", group=grpFiboColor)
i_unitNumberColor = input.color(color.new(color.rgb(190, 198, 204), 42), "Unit number text", group=grpFiboColor)

grpFiboPick = "═══ Fibonacci Grid — Ratios to Show ═══"
i_fgShow0    = input.bool(true, "0.0",   group=grpFiboPick, inline="fg1")
i_fgShow118  = input.bool(true, "11.8",  group=grpFiboPick, inline="fg1")
i_fgShow236  = input.bool(true, "23.6",  group=grpFiboPick, inline="fg1")
i_fgShow382  = input.bool(true, "38.2",  group=grpFiboPick, inline="fg2")
i_fgShow50   = input.bool(true, "50.0",  group=grpFiboPick, inline="fg2")
i_fgShow618  = input.bool(true, "61.8",  group=grpFiboPick, inline="fg2")
i_fgShow764  = input.bool(true, "76.4",  group=grpFiboPick, inline="fg3")
i_fgShow88   = input.bool(true, "88.0",  group=grpFiboPick, inline="fg3")
i_fgShow100  = input.bool(true, "100.0", group=grpFiboPick, inline="fg3")
i_fgShow1118 = input.bool(true, "111.8", group=grpFiboPick, inline="fg4")
i_fgShow1236 = input.bool(true, "123.6", group=grpFiboPick, inline="fg4")
i_fgShow1382 = input.bool(true, "138.2", group=grpFiboPick, inline="fg4")
i_fgShowN118 = input.bool(true, "-11.8", group=grpFiboPick, inline="fg5")
i_fgShowN236 = input.bool(true, "-23.6", group=grpFiboPick, inline="fg5")
i_fgShowN382 = input.bool(true, "-38.2", group=grpFiboPick, inline="fg5")

grpEye = "═══ AIB Eye Comfort Theme ═══"
i_enableEyeComfort = input.bool(true, "Enable Eye Comfort theme", group=grpEye)
i_themePreset = input.string("Soft Dark", "Theme", options=["Soft Dark", "Soft Light", "Neutral", "High Visibility", "Custom"], group=grpEye)
i_applyBackground = input.bool(true, "Apply background tint", group=grpEye)
i_applyCandleColors = input.bool(true, "Apply candle colors", group=grpEye)
i_customBackground = input.color(color.rgb(17, 23, 29), "Custom background", group=grpEye)
i_customBullCandle = input.color(color.rgb(63, 135, 121), "Custom bullish candle", group=grpEye)
i_customBearCandle = input.color(color.rgb(156, 88, 92), "Custom bearish candle", group=grpEye)
i_otherTFDim = input.int(12, "Additional transparency for other TFs", minval=0, maxval=35, group=grpEye)
i_nearZoneATR = input.float(0.60, "Near-zone distance (ATR)", minval=0.05, maxval=5.0, step=0.05, group=grpEye)
i_currentTFEmphasis = input.bool(true, "Emphasize current timeframe", group=grpEye)

// ═══════════════════════════════════════════════════════════════
//  MTF TEST ZONES
// ═══════════════════════════════════════════════════════════════

grpMTF = "═══ MTF — General ═══"
i_enableMTFZones          = input.bool(true, "Enable MTF test zones", group=grpMTF)
i_mtfShowZones            = input.bool(true, "Show test-zone rectangles", group=grpMTF)
i_mtfConfirmedOnly        = input.bool(true, "Confirmed angles only", group=grpMTF)
i_mtfDisplayMode          = input.string("Current + higher", "Display mode", options=["Current only", "Current + higher", "Current + lower", "All enabled", "Custom per slot"], group=grpMTF)
i_mtfAllowLowerTF         = input.bool(false, "Allow lower-timeframe sources", group=grpMTF)
i_mtfLowerTFMaxRatio      = input.int(24, "Maximum chart/source ratio for lower TF", minval=2, maxval=240, group=grpMTF)
i_mtfCalcBars             = input.int(6000, "Custom requested source bars", minval=1000, maxval=50000, step=500, group=grpMTF)
i_mtfMaxTrackedZones      = input.int(260, "Custom maximum tracked zones", minval=40, maxval=800, group=grpMTF)
i_mtfMaxVisibleZones      = input.int(55, "Custom maximum visible zone boxes", minval=10, maxval=180, group=grpMTF)
i_mtfKeepBrokenZones      = input.bool(true, "Allow historical zones", group=grpMTF)
i_mtfShowStatus           = input.bool(true, "Show test status", group=grpMTF)
i_mtfIncludeChartTF       = input.bool(true, "Always calculate the current chart timeframe", group=grpMTF, tooltip="Ensures the four tests are available on any supported chart timeframe, even when none of the five MTF slots matches the chart.")
i_mtfChartTFColor         = input.color(color.rgb(116, 132, 142), "Current-TF frame color", group=grpMTF)
i_mtfChartTFConfluence    = input.bool(true, "Include current TF in confluence", group=grpMTF)

grpLife = "═══ Zone Lifecycle / History ═══"
i_failedZoneMode = input.string("Ghost", "Failed / unresolved zones", options=["Hide", "Ghost", "Full"], group=grpLife)
i_completedZoneMode = input.string("Ghost", "Completed TP zones after break", options=["Hide", "Ghost", "Full"], group=grpLife)
i_ghostTransparency = input.int(96, "Ghost transparency", minval=88, maxval=100, group=grpLife)
i_maxGhostZones = input.int(12, "Custom maximum Ghost zones", minval=0, maxval=80, group=grpLife)
i_keepTP3ValidZones = input.bool(true, "Keep TP3 zone extending until later break", group=grpLife)

grpMTFStyle = "═══ MTF — Zone Style ═══"
i_mtfSupportColor         = input.color(color.rgb(35, 83, 73), "Custom support-zone fill", group=grpMTFStyle)
i_mtfResistanceColor      = input.color(color.rgb(103, 63, 67), "Custom resistance-zone fill", group=grpMTFStyle)
i_mtfZoneTransparency     = input.int(92, "Untouched-zone transparency", minval=50, maxval=98, group=grpMTFStyle)
i_mtfActiveTransparency   = input.int(85, "Touched/active transparency", minval=50, maxval=96, group=grpMTFStyle)
i_mtfBorderWidth          = input.int(1, "Zone border width", minval=1, maxval=4, group=grpMTFStyle)
i_mtfTextColor            = input.color(color.rgb(190, 198, 204), "Custom zone text color", group=grpMTFStyle)
i_mtfTextSize             = input.string("Normal", "On-chart label size", options=["Tiny", "Small", "Normal", "Large"], group=grpMTFStyle, tooltip="Controls zone labels, lot readout, stop-loss text and projection TP/SL numbers.")
i_mtfLabelMode            = input.string("Minimal", "Zone label mode", options=["Full", "Compact", "Minimal"], group=grpMTFStyle)
i_mtfShowZoneText         = input.bool(true, "Label only active zones near price", group=grpMTFStyle, tooltip="Keeps a class label on the zones price is interacting with, and hides text on all other rectangles so labels never overlap.")

grpZoneAux = "═══ Zone Lot / Stop-Loss (near price) ═══"
i_showLotInZone   = input.bool(true, "Show lot size inside zone (right)", group=grpZoneAux, tooltip="When price approaches an active zone, the risk-based lot appears near its right edge for a fast decision. Needs Risk sizing enabled.")
i_zoneLotText     = input.color(color.rgb(230, 224, 205), "Lot text color", group=grpZoneAux)
i_zoneLotBg       = input.color(color.rgb(26, 32, 44), "Lot background", group=grpZoneAux)
i_showZoneSL      = input.bool(true, "Show dashed stop-loss line", group=grpZoneAux, tooltip="Sell zones: dashed SL above the zone. Buy zones: below. The spread is added to the zone boundary.")
i_spreadPoints    = input.int(0, "Spread (points) added to SL", minval=0, maxval=100000, group=grpZoneAux, tooltip="Pine cannot read the live broker spread, so enter the pair's typical spread in points. It is added beyond the zone boundary.")
i_zoneSLColor     = input.color(color.rgb(181, 84, 78), "Stop-loss line color", group=grpZoneAux)
i_zoneSLText      = input.color(color.rgb(214, 158, 152), "Stop-loss text color", group=grpZoneAux)

grpZoneFib = "═══ Key Fib Ratios inside Zones ═══"
i_showZoneFibLevels = input.bool(true, "Highlight key fib ratios that land inside a zone", group=grpZoneFib, tooltip="For every test zone, the extended fib ratios (…±23.6, ±76.4, ±123.6 … ±623.6) of its reference range are drawn where they fall inside the rectangle.")
i_zoneFibMode = input.string("Only inside test zones", "When to draw the ratios", options=["Only inside test zones", "Always (whole reference range)"], group=grpZoneFib, tooltip="'Only inside test zones' draws a ratio only where it falls inside a test rectangle. 'Always' draws every enabled ratio of each zone's reference range regardless of the rectangle boundary.")
i_zoneFibColor      = input.color(color.rgb(176, 132, 255), "Fib level color", group=grpZoneFib)
i_zoneFibWidth      = input.int(2, "Fib level line width", minval=1, maxval=5, group=grpZoneFib)
i_zoneFibMaxLevels  = input.int(30, "Max fib highlights", minval=4, maxval=80, group=grpZoneFib, tooltip="Upper bound on how many in-zone fib lines are drawn at once, to stay light.")

grpZoneFibPick = "═══ Which Fib Ratios to Draw ═══"
i_fibP236 = input.bool(true, "+23.60",  group=grpZoneFibPick, inline="r236")
i_fibN236 = input.bool(true, "-23.60",  group=grpZoneFibPick, inline="r236")
i_fibP764 = input.bool(true, "+76.40",  group=grpZoneFibPick, inline="r764")
i_fibN764 = input.bool(true, "-76.40",  group=grpZoneFibPick, inline="r764")
i_fibP1236 = input.bool(true, "+123.60", group=grpZoneFibPick, inline="r1236")
i_fibN1236 = input.bool(true, "-123.60", group=grpZoneFibPick, inline="r1236")
i_fibP1764 = input.bool(true, "+176.40", group=grpZoneFibPick, inline="r1764")
i_fibN1764 = input.bool(true, "-176.40", group=grpZoneFibPick, inline="r1764")
i_fibP2236 = input.bool(true, "+223.60", group=grpZoneFibPick, inline="r2236")
i_fibN2236 = input.bool(true, "-223.60", group=grpZoneFibPick, inline="r2236")
i_fibP2764 = input.bool(true, "+276.40", group=grpZoneFibPick, inline="r2764")
i_fibN2764 = input.bool(true, "-276.40", group=grpZoneFibPick, inline="r2764")
i_fibP3236 = input.bool(true, "+323.60", group=grpZoneFibPick, inline="r3236")
i_fibN3236 = input.bool(true, "-323.60", group=grpZoneFibPick, inline="r3236")
i_fibP3764 = input.bool(true, "+376.40", group=grpZoneFibPick, inline="r3764")
i_fibN3764 = input.bool(true, "-376.40", group=grpZoneFibPick, inline="r3764")
i_fibP4236 = input.bool(true, "+423.60", group=grpZoneFibPick, inline="r4236")
i_fibN4236 = input.bool(true, "-423.60", group=grpZoneFibPick, inline="r4236")
i_fibP4764 = input.bool(true, "+476.40", group=grpZoneFibPick, inline="r4764")
i_fibN4764 = input.bool(true, "-476.40", group=grpZoneFibPick, inline="r4764")
i_fibP5236 = input.bool(true, "+523.60", group=grpZoneFibPick, inline="r5236")
i_fibN5236 = input.bool(true, "-523.60", group=grpZoneFibPick, inline="r5236")
i_fibP5764 = input.bool(true, "+576.40", group=grpZoneFibPick, inline="r5764")
i_fibN5764 = input.bool(true, "-576.40", group=grpZoneFibPick, inline="r5764")
i_fibP6236 = input.bool(true, "+623.60", group=grpZoneFibPick, inline="r6236")
i_fibN6236 = input.bool(true, "-623.60", group=grpZoneFibPick, inline="r6236")

grpMTFOverlap = "═══ MTF — Confluence ═══"
i_mtfShowConfluence       = input.bool(true, "Highlight overlapping zones", group=grpMTFOverlap)
i_mtfCrossTFOnly          = input.bool(false, "Cross-timeframe overlaps only", group=grpMTFOverlap)
i_mtfMaxConfluenceBoxes   = input.int(16, "Custom maximum confluence boxes", minval=0, maxval=80, group=grpMTFOverlap)
i_mtfOverlapScanLimit     = input.int(45, "Active zones checked per new zone", minval=8, maxval=120, group=grpMTFOverlap)
i_mtfKeepClosedConfluence = input.bool(false, "Keep closed confluences as Ghost", group=grpMTFOverlap)
i_mtfConfluenceColor      = input.color(color.rgb(206, 170, 84), "Confluence fill", group=grpMTFOverlap)
i_mtfConfluenceActiveTransp = input.int(72, "Confluence fill transparency", minval=40, maxval=95, group=grpMTFOverlap, tooltip="Softens the golden intersection glow so it no longer masks the candles underneath.")
i_mtfConfluenceBorder     = input.color(color.rgb(224, 186, 104), "Confluence border", group=grpMTFOverlap)
i_mtfConfluenceText       = input.color(color.rgb(201, 205, 209), "Confluence text", group=grpMTFOverlap)
i_mtfConfluenceWidth      = input.int(1, "Confluence border width", minval=1, maxval=4, group=grpMTFOverlap)

grpCombo = "═══ Combo Filter (283) ═══"
i_enableComboFilter = input.bool(false, "Enable 283-combo filter", group=grpCombo, tooltip="When ON, zones whose 5-char combo is in the 283 validated combos show ✓ (green text); zones outside the table show ✗ (red text). Every zone still draws.")

grpTestFilter = "═══ Test Zone Visibility ═══"
i_showTestU1B = input.bool(true, "U1X1  BUY",  group=grpTestFilter, inline="u1", tooltip="U1X1: resistance zone above U1 for BUY angles.")
i_showTestU1S = input.bool(true, "SELL",        group=grpTestFilter, inline="u1", tooltip="U1X1: support zone below U1 for SELL angles.")
i_showTestU2B = input.bool(true, "U2X1  BUY",  group=grpTestFilter, inline="u2", tooltip="U2X1: support zone below U2 for BUY angles.")
i_showTestU2S = input.bool(true, "SELL",        group=grpTestFilter, inline="u2", tooltip="U2X1: resistance zone above U2 for SELL angles.")
i_showTestDLB = input.bool(true, "DLX1  BUY",  group=grpTestFilter, inline="dl", tooltip="Left diagonal zone (BZLX1) for BUY angles.")
i_showTestDLS = input.bool(true, "SELL",        group=grpTestFilter, inline="dl", tooltip="Left diagonal zone (SZLX1) for SELL angles.")
i_showTestDRB = input.bool(true, "DRX1  BUY",  group=grpTestFilter, inline="dr", tooltip="Right diagonal zone (BZRX1) for BUY angles.")
i_showTestDRS = input.bool(true, "SELL",        group=grpTestFilter, inline="dr", tooltip="Right diagonal zone (SZRX1) for SELL angles.")

grpDash = "═══ Active Zones Dashboard ═══"
i_showDashboard = input.bool(true, "Show active zones dashboard", group=grpDash)
i_dashboardRows = input.int(6, "Rows", minval=3, maxval=10, group=grpDash)
i_dashboardShowDistance = input.bool(true, "Show distance", group=grpDash)

grpProjection = "═══ Expected Scenario Path ═══"
i_projectionMode = input.string("Nearest active zone", "Projection", options=["Off", "Nearest active zone", "Nearest current-TF zone", "Strongest confluence"], group=grpProjection)
i_projectionBarsPerLeg = input.int(8, "Bars per TP leg", minval=2, maxval=30, group=grpProjection)
i_projectionWidth = input.int(2, "Line width", minval=1, maxval=4, group=grpProjection)
i_projectionTransparency = input.int(30, "Line transparency", minval=0, maxval=90, group=grpProjection)
i_projectionShowTPLabels = input.bool(true, "Show Entry / SL / TP prices on projection path", group=grpProjection, tooltip="Prices are shown only on the single projected scenario path, never inside zone rectangles.")
i_projectionShowSLLabel = input.bool(true, "Show SL price beside projection path", group=grpProjection)
i_projectionLabelOffset = input.int(3, "TP/SL label offset (bars to the right)", minval=0, maxval=20, group=grpProjection, tooltip="Moves the Entry/TP/SL numbers to the right of the projection line so they do not sit on top of it.")

grpRisk = "═══ Risk Management / Position Size ═══"
i_enableRiskSizing = input.bool(true, "Enable risk sizing", group=grpRisk)
i_riskAmount = input.float(100.0, "Accepted loss per trade", minval=0.0, step=1.0, group=grpRisk, tooltip="Amount in the selected account currency.")
i_riskAccountCurrency = input.string("USD", "Account currency", options=["USD", "EUR", "GBP", "JPY", "CHF", "AUD", "CAD", "NZD"], group=grpRisk)
