i_manualCurrencyRate = input.float(1.0, "Fallback quote-to-account conversion", minval=0.000001, step=0.0001, group=grpRisk, tooltip="Used only when TradingView cannot resolve the currency conversion automatically.")
i_maxRecommendedSize = input.float(0.0, "Maximum recommended size (0 = no cap)", minval=0.0, step=0.01, group=grpRisk)
i_showRiskInZoneText = input.bool(false, "Show risk size inside zone text", group=grpRisk)
i_showRiskInDashboard = input.bool(true, "Show SL distance and size in dashboard", group=grpRisk)

grpReport = "═══ Reports / Excel Export Stream ═══"
i_reportHistoricalLog = input.bool(false, "Generate historical JSON rows in Pine Logs", group=grpReport, tooltip="Personal scripts only. Toggle ON, reopen Pine Logs, then save/copy the rows for the companion Excel builder.")
