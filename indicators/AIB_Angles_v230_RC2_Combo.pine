i_reportIncludeOpenSnapshots = input.bool(true, "Include open/untouched tests at report end", group=grpReport, tooltip="Adds one final snapshot row for tests that are still WAITING or ACTIVE at the end of the selected history.")
i_reportStartTime = input.time(timestamp("01 Jan 2020 00:00 +0000"), "Historical report start", group=grpReport)
i_reportEndTime   = input.time(timestamp("31 Dec 2099 23:59 +0000"), "Historical report end", group=grpReport)

